# Copy to .env and fill in. Never commit .env or a real secret key.
# Testnet is the default environment. Mainnet deployment requires ALLOW_MAINNET=1
# after completing docs/mainnet-checklist.md.

# Name of the funded stellar CLI identity used by deployment scripts.
STELLAR_IDENTITY=umbra

# Network target (testnet | futurenet | mainnet).
STELLAR_NETWORK=testnet

# Explicit safety gate for mainnet deployments (0 = blocked, 1 = permitted).
ALLOW_MAINNET=0

# Demo script account aliases (created and funded via Friendbot on testnet).
UMBRA_BUYER_IDENTITY=umbra-buyer
UMBRA_SELLER_IDENTITY=umbra-seller
UMBRA_ARBITER_IDENTITY=umbra-arbiter

# Default demo escrow parameters (in stroops and seconds).
DEMO_ESCROW_AMOUNT=500000000
DEMO_DISPUTE_BOND=0
DEMO_CONFIRM_WINDOW=86400
DEMO_DISPUTE_WINDOW=86400
